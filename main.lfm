  object pcMain: TPageControl
    Left = 0
    Height = 430
    Top = 82
    Width = 1000
    ActivePage = tsFormat
    Align = alClient
    TabOrder = 3
    object tsFormat: TTabSheet
      Caption = '按格式分组'
      ClientWidth = 996
      ClientHeight = 400
      object pnlFmtTools: TPanel
        Left = 0
        Height = 34
        Top = 0
        Width = 996
        Align = alTop
        BevelOuter = bvNone
        TabOrder = 0
        object btnMapAdd: TButton
          Left = 0
          Height = 32
          Top = 1
          Width = 88
          Align = alLeft
          BorderSpacing.Around = 1
          Caption = '添加一行'
          OnClick = btnMapAddClick
          TabOrder = 0
        end
        object btnMapDel: TButton
          Left = 90
          Height = 32
          Top = 1
          Width = 92
          Align = alLeft
          BorderSpacing.Around = 1
          Caption = '删除所选行'
          OnClick = btnMapDelClick
          TabOrder = 1
        end
      end
      object lblFormatHelp: TLabel
        Left = 0
        Height = 46
        Top = 354
        Width = 996
        Align = alBottom
        AutoSize = False
        BorderSpacing.Left = 8
        BorderSpacing.Right = 8
        BorderSpacing.Bottom = 2
        Caption = '说明：扩展名统一转小写做目录名（.JPG 和 .jpg 同组），分组目录建在输出目录下；无扩展名文件进 _noext 目录；未列出的扩展名自动按自身扩展名建目录，映射表只负责合并与改名。'
        WordWrap = True
      end
      object gridMap: TStringGrid
        Left = 0
        Height = 356
        Top = 0
        Width = 996
        Align = alClient
        ColCount = 2
        FixedCols = 0
        FixedRows = 1
        OnResize = GridResize
        Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goColSizing, goEditing, goTabs]
        RowCount = 1
        TabOrder = 1
      end
    end
    object tsFlatten: TTabSheet
      Caption = '打平目录'
      ClientWidth = 996
      ClientHeight = 400
      object lblFlattenHelp: TLabel
        Left = 0
        Height = 56
        Top = 0
        Width = 996
        Align = alTop
        AutoSize = False
        BorderSpacing.Left = 8
        BorderSpacing.Right = 8
        BorderSpacing.Bottom = 4
        Caption = '说明：把源目录（含子目录）中的文件移动/复制到输出目录顶层；输出目录默认为源目录（此时顶层已有文件保持不动）；重名冲突按顶部设置处理；重复执行是安全的（已到位的文件自动跳过）。'
        WordWrap = True
      end
      object chkDelEmpty: TCheckBox
        Left = 0
        Height = 24
        Top = 60
        Width = 996
        Align = alTop
        Caption = '执行（移动）后删除已清空的子目录'
        TabOrder = 0
      end
    end
