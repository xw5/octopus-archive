      object pnlRegOpts: TPanel
        Left = 0
        Height = 30
        Top = 34
        Width = 996
        Align = alTop
        BevelOuter = bvNone
        TabOrder = 1
        object chkFullname: TCheckBox
          Left = 0
          Height = 30
          Top = 0
          Width = 230
