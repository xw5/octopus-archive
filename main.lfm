      object lblRegexHelp: TLabel
        Left = 0
        Height = 46
        Top = 354
        Width = 996
        Align = alBottom
        AutoSize = False
        BorderSpacing.Left = 8
        BorderSpacing.Right = 8
        BorderSpacing.Bottom = 2
        Caption = '说明：规则按列表顺序匹配，第一个命中的规则生效；未匹配的文件保持不动；目标目录名相对输出目录（可含子路径），留空 = 移到输出目录顶层。类 PCRE 语法。'
        WordWrap = True
      end
      object gridRules: TStringGrid
